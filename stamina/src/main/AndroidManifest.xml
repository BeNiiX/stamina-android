<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fusionnées dans le manifest de l'app : GAID lisible, réseau. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application>
        <!-- Démarrage automatique si l'app déclare <meta-data android:name="io.getstamina.API_KEY" …/>.
             Sans cette meta-data, l'initializer ne fait rien et Stamina.configure() reste la voie normale. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="io.getstamina.sdk.StaminaInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
